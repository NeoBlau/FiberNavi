# Скопируй в Backend/.env и поправь под себя.

# Регион: Москва + Московская область (west,south,east,north).
REGION_NAME=moscow
REGION_BBOX=35.14,54.25,40.21,56.96

# OSM-выгрузка, которая покрывает регион. Обрезается по REGION_BBOX, если установлен osmium.
OSM_PBF_URL=https://download.geofabrik.de/russia/central-fed-district-latest.osm.pbf

# Дневная сборка базовой карты Protomaps. Список дат: https://maps.protomaps.com/builds
# Сборки старше месяца удаляются, поэтому дату надо обновлять.
PROTOMAPS_BUILD_URL=https://build.protomaps.com/20261026.pmtiles
PMTILES_MAXZOOM=15

# Photon: версия jar и дамп базы для этой же мажорной версии.
# Дампы лежат на https://download1.graphhopper.com/public/ — с 2025 года разложены по континентам.
# Найди там дамп России (или Европы) под Photon 1.x и вставь точный URL.
PHOTON_VERSION=1.3.0
PHOTON_JAR_URL=https://github.com/komoot/photon/releases/download/1.3.0/photon-1.3.0.jar
PHOTON_DUMP_URL=

# Адрес, по которому телефон видит сервер (для TileJSON у pmtiles serve).
PUBLIC_BASE_URL=http://localhost
